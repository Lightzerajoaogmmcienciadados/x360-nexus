<?xml version="1.0" encoding="utf-8"?>
<!-- v5.6: fullscreen game surface plus safe-area constrained virtual Xbox 360 pad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0E12" android:keepScreenOn="true">
    <SurfaceView android:id="@+id/gameSurface" android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameControls" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipChildren="false">
        <TextView android:id="@+id/gameFps" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="-- FPS"
            android:textSize="11sp" android:fontFamily="monospace"
            android:textColor="#B5E5BF" android:padding="5dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <Button android:id="@+id/gameMenu" android:layout_width="94dp" android:layout_height="38dp"
            android:text="MENU / LOG" android:textSize="10sp" android:textColor="#FFFFFF"
            android:backgroundTint="#99323C39" android:minHeight="0dp" android:minWidth="0dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/gameLB" android:layout_width="54dp" android:layout_height="38dp"
            android:text="LB" android:textSize="11sp" android:alpha="0.72" android:minHeight="0dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/gameFps"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/gameLT" android:layout_width="54dp" android:layout_height="38dp"
            android:text="LT" android:textSize="11sp" android:alpha="0.72" android:minHeight="0dp"
            android:layout_marginStart="6dp" app:layout_constraintStart_toEndOf="@id/gameLB"
            app:layout_constraintTop_toTopOf="@id/gameLB" />
        <Button android:id="@+id/gameRT" android:layout_width="54dp" android:layout_height="38dp"
            android:text="RT" android:textSize="11sp" android:alpha="0.72" android:minHeight="0dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/gameMenu"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/gameRB" android:layout_width="54dp" android:layout_height="38dp"
            android:text="RB" android:textSize="11sp" android:alpha="0.72" android:minHeight="0dp"
            android:layout_marginEnd="6dp" app:layout_constraintEnd_toStartOf="@id/gameRT"
            app:layout_constraintTop_toTopOf="@id/gameRT" />
        <com.x360nexus.AnalogPad android:id="@+id/gameLeftStick"
            android:layout_width="96dp" android:layout_height="96dp"
            android:layout_marginStart="8dp" android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gameDpad" android:layout_width="106dp" android:layout_height="106dp"
            android:layout_marginStart="8dp" app:layout_constraintStart_toEndOf="@id/gameLeftStick"
            app:layout_constraintBottom_toBottomOf="@id/gameLeftStick">
            <Button android:id="@+id/gameUp" android:layout_width="38dp" android:layout_height="38dp"
                android:text="↑" android:alpha="0.65" android:minWidth="0dp" android:minHeight="0dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <Button android:id="@+id/gameLeft" android:layout_width="38dp" android:layout_height="38dp"
                android:text="←" android:alpha="0.65" android:minWidth="0dp" android:minHeight="0dp"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button android:id="@+id/gameRight" android:layout_width="38dp" android:layout_height="38dp"
                android:text="→" android:alpha="0.65" android:minWidth="0dp" android:minHeight="0dp"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button android:id="@+id/gameDown" android:layout_width="38dp" android:layout_height="38dp"
                android:text="↓" android:alpha="0.65" android:minWidth="0dp" android:minHeight="0dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.x360nexus.AnalogPad android:id="@+id/gameRightStick"
            android:layout_width="96dp" android:layout_height="96dp"
            android:layout_marginEnd="8dp" android:layout_marginBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gameFaceCluster" android:layout_width="134dp" android:layout_height="134dp"
            android:layout_marginBottom="8dp" app:layout_constraintBottom_toTopOf="@id/gameRightStick"
            app:layout_constraintEnd_toEndOf="parent">
            <Button android:id="@+id/gameY" android:layout_width="44dp" android:layout_height="44dp"
                android:text="Y" android:textColor="#FFFFFF" android:backgroundTint="#AA9B8A1A"
                android:minWidth="0dp" android:minHeight="0dp" android:alpha="0.80"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <Button android:id="@+id/gameX" android:layout_width="44dp" android:layout_height="44dp"
                android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA276CB2"
                android:minWidth="0dp" android:minHeight="0dp" android:alpha="0.80"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button android:id="@+id/gameB" android:layout_width="44dp" android:layout_height="44dp"
                android:text="B" android:textColor="#FFFFFF" android:backgroundTint="#AAB53A32"
                android:minWidth="0dp" android:minHeight="0dp" android:alpha="0.80"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <Button android:id="@+id/gameA" android:layout_width="44dp" android:layout_height="44dp"
                android:text="A" android:textColor="#FFFFFF" android:backgroundTint="#AA107C10"
                android:minWidth="0dp" android:minHeight="0dp" android:alpha="0.80"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button android:id="@+id/gameBack" android:layout_width="68dp" android:layout_height="34dp"
            android:text="BACK" android:textSize="10sp" android:alpha="0.70" android:minHeight="0dp"
            android:layout_marginEnd="8dp" android:layout_marginBottom="12dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/gameStart"
            app:layout_constraintBottom_toBottomOf="parent" />
        <Button android:id="@+id/gameStart" android:layout_width="68dp" android:layout_height="34dp"
            android:text="START" android:textSize="10sp" android:alpha="0.70" android:minHeight="0dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toEndOf="@id/gameBack" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout android:id="@+id/gameConsolePanel" android:layout_width="match_parent"
        android:layout_height="220dp" android:layout_gravity="center"
        android:orientation="vertical" android:padding="12dp" android:visibility="gone"
        android:background="#EE181A20">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/gameCloseLog" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:text="FECHAR LOG" android:textSize="11sp" />
            <Button android:id="@+id/gameExit" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:text="SAIR DO JOGO" android:textSize="11sp" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/gameConsole" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#BBEFC7"
                android:textSize="11sp" android:fontFamily="monospace" android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
